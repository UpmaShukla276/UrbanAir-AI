# If your backend runs locally on port 8000, you don't need a .env at all.

# Where the dashboard should send its API requests.
# Local development:
VITE_API_BASE_URL=http://127.0.0.1:8000

# For a deployed site, put your backend's public URL here (no trailing slash), e.g.
# VITE_API_BASE_URL=https://your-backend.example.com
#
# Note: Vite reads this at BUILD time. If you change it on your hosting
# platform, trigger a new build for it to take effect.
