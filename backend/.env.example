# --- Required -------------------------------------------------------------

# Live AQI + pollutant data.
# Free token: https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here

# Wind data + pollutant forecast.
# Free key: https://openweathermap.org/api
# (New keys can take a while to activate -- if the forecast errors out right
# after signing up, wait a bit and try again.)
OWM_API_KEY=your_openweathermap_key_here

# --- Optional -------------------------------------------------------------

# How often the background job fetches fresh data for all 21 locations.
# Default is 15. Lower = fresher data but more API calls.
FETCH_INTERVAL_MINUTES=15

# Only needed if you want the Alerts page to actually send emails.
# Leave these blank and the app will simply say email isn't configured.
# For Gmail, use an "App Password", not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
